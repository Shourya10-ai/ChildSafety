# Child Safety Platform

## Byte-level ignores
*.pyc
__pycache__/
*.pyo
*.egg-info/
dist/
build/
*.egg

# Environment
.env
*.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# Python
venv/
.venv/
*.so
pip-log.txt

# Android
android/ChildSafety/.gradle/
android/ChildSafety/build/
android/ChildSafety/app/build/
android/ChildSafety/local.properties
android/ChildSafety/captures/
android/ChildSafety/.externalNativeBuild/
