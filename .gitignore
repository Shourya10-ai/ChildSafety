# Model files (large)
ai_server/model_store/*.bin
ai_server/model_store/*.pt
ai_server/model_store/*.onnx
ai_server/model_store/*.safetensors
!ai_server/model_store/.gitkeep

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Firebase credentials (NEVER commit)
**/google-services.json
**/firebase-credentials.json

# Coverage
htmlcov/
.coverage
coverage.xml

# Databases & local storage
*.db
*.sqlite
backend/storage/
