# ==============================================================================
# Child Safety Platform — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# ==============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ChildSafetyPlatform
ENVIRONMENT=development
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=childsafety
POSTGRES_PASSWORD=childsafety_dev_2024
POSTGRES_DB=childsafety
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://childsafety:childsafety_dev_2024@localhost:5432/childsafety

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=childsafety_neo4j_2024
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=childsafety_minio
MINIO_SECRET_KEY=childsafety_minio_secret_2024
MINIO_BUCKET=childsafety-evidence
MINIO_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Server ─────────────────────────────────────────────────────────────────
AI_SERVER_URL=http://localhost:8001
AI_SERVER_PORT=8001
AI_DEVICE=cpu

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# ── Firebase (for push notifications) ─────────────────────────────────────────
# Provide these in Phase 8
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── Google Maps ───────────────────────────────────────────────────────────────
# Provide in Phase 6
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── LLM (for RAG / AI Assistant) ─────────────────────────────────────────────
# Provide in Phase 11
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_llm_api_key
# LLM_MODEL_NAME=gemini-pro

# ── HuggingFace (for model downloads) ────────────────────────────────────────
# Provide in Phase 7 if using gated models
# HF_TOKEN=your_huggingface_token
